# TLS for the relay. Caddy gets and renews the RELAY_HOST cert itself once the
# A record points here.
#
# Caddy overwrites a client's X-Forwarded-For with the real peer address. strfry
# reads it (realIpHeader) and the write policy rate-limits by it. Behind another
# proxy (Cloudflare's orange cloud) every client shows up as that proxy. See README.md.
#
# HTTP/3 off. WebSockets don't run over it, and only TCP ports are published,
# so Caddy would advertise a port nobody can reach.
{
	servers {
		protocols h1 h2
	}
}

{$RELAY_HOST} {
	reverse_proxy strfry:7777
}
