# Copy to .env and fill in. Every service in docker-compose.yml reads it.

# Public host name. Point its A record here before first start or Caddy can't
# get a cert (AAAA only with IPv6 on the Docker network, see README.md).
# Relay URL becomes wss://<RELAY_HOST>.
RELAY_HOST=relay.example.com

# Only if clients reach it at a different URL (NIP-42 AUTH needs an exact match).
# RELAY_URL=wss://relay.example.com

# NIP-11 info shown to clients.
RELAY_NAME=flexmydomain
RELAY_CONTACT=
# Operator pubkey, npub or 64-char hex.
RELAY_ADMIN_PUBKEY=

# Flex board zap recipient (featuredRecipientPubkey in web/assets/config.js),
# 64-char hex. When set, only flex zaps paid to it are kept and mirrored.
FMD_FLEX_RECIPIENT=

# Verifier pubkeys, 64-char hex, comma-separated. Their NIP-90 job feedback is kept.
FMD_VERIFIERS=

# Gift wraps (kind 1059) stay off until the private channel has a UI. See policy.ts.
FMD_ACCEPT_GIFT_WRAPS=0

# Writes allowed per client IP.
FMD_RATE_PER_MINUTE=30
FMD_RATE_BURST=60

# Mirror: stream new events from UPSTREAM_RELAYS and backfill what it missed,
# at start-up and every FMD_BACKFILL_HOURS (0 = start-up only). FMD_MIRROR=0
# turns both off.
FMD_MIRROR=1
FMD_BACKFILL_HOURS=1

# Relays to mirror, space-separated. Default: the five the site reads. The
# router streams from all. Backfill needs negentropy (NIP-77), which most public
# relays turn off. Each backfill logs which ones synced.
# UPSTREAM_RELAYS=wss://relay.damus.io wss://nos.lol wss://relay.primal.net wss://nostr.oxtr.dev wss://nostr.mom
