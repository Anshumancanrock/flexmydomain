# Copy to .env and fill in. docker-compose.yml reads it for every service.

# The relay's public host name. Point its DNS A record at this server before
# the first start, or Caddy cannot get a certificate. (AAAA too only with IPv6
# on the Docker network: see README.md.) The relay's URL is derived from it:
# wss://<RELAY_HOST>.
RELAY_HOST=relay.example.com

# Only if clients reach it at a different URL (NIP-42 AUTH needs an exact match).
# RELAY_URL=wss://relay.example.com

# NIP-11 details shown to clients.
RELAY_NAME=flexmydomain
RELAY_CONTACT=
# The operator's pubkey, npub or 64-character hex.
RELAY_ADMIN_PUBKEY=

# The flex board's zap recipient: web/assets/config.js featuredRecipientPubkey,
# as 64-character hex. When set, only flex zaps paid to it are kept and mirrored.
FMD_FLEX_RECIPIENT=

# Verifier pubkeys (64-character hex, comma-separated) whose NIP-90 job feedback is kept.
FMD_VERIFIERS=

# Gift wraps (kind 1059) stay off until the private channel has a UI. See policy.ts.
FMD_ACCEPT_GIFT_WRAPS=0

# Writes allowed per client IP.
FMD_RATE_PER_MINUTE=30
FMD_RATE_BURST=60

# The mirror: new flexmydomain events are streamed down from UPSTREAM_RELAYS,
# and a backfill fetches anything the stream missed, at start-up and then
# every FMD_BACKFILL_HOURS (0: at start-up only). FMD_MIRROR=0 turns both off.
FMD_MIRROR=1
FMD_BACKFILL_HOURS=1

# Relays mirrored from, space-separated. Default: the five the site reads. The
# router streams from all of them; the backfill needs negentropy (NIP-77), which
# most public relays have switched off. Each backfill's log says which synced.
# UPSTREAM_RELAYS=wss://relay.damus.io wss://nos.lol wss://relay.primal.net wss://nostr.oxtr.dev wss://nostr.mom
